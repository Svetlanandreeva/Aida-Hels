{
  "expo": {
    "name": "Aida",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.lifehealthhub.b7m5uj",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan lab reports to track your results",
        "NSPhotoLibraryUsageDescription": "Upload lab report photos to your timeline",
        "NSHealthShareUsageDescription": "Aida reads health and activity data you choose to share so it can show trends, summaries and health context."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.background-delivery": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#EAEAE8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.lifehealthhub.b7m5uj",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "SCHEDULE_EXACT_ALARM",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_VO2_MAX",
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.READ_BODY_FAT",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-document-picker",
      "expo-notifications",
      "./plugins/with-health-connect-min-sdk",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EAEAE8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
