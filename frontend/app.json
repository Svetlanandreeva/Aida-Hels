{
  "expo": {
    "name": "Aida",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.lifehealthhub.b7m5uj",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan lab reports to track your results",
        "NSPhotoLibraryUsageDescription": "Upload lab report photos to your timeline"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#EAEAE8"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.lifehealthhub.b7m5uj",
      "permissions": ["CAMERA", "READ_MEDIA_IMAGES", "SCHEDULE_EXACT_ALARM"]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-image-picker",
      "expo-document-picker",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#EAEAE8"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
