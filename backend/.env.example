# Aida 2.0 production storage
# Keep real values in server/GitHub secrets, never commit credentials or production IDs.
# Until mass launch, Google Sheets/Drive are the canonical persistence layer.
GOOGLE_SERVICE_ACCOUNT_JSON={}
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_DRIVE_UPLOADS_FOLDER_ID=

# Authentication
# Generate a random secret of at least 32 characters for production.
JWT_SECRET=
JWT_ISSUER=aida-2.0
JWT_ACCESS_MINUTES=10080

# Transactional email: registration verification + password recovery.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SSL=false
SMTP_STARTTLS=true
EMAIL_VERIFY_MINUTES=30
EMAIL_VERIFY_BASE_URL=https://aidaassistent.ru/api/auth/verify-email
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_BASE_URL=https://aidaassistent.ru/reset-password

# User sign-in via Yandex ID and VK ID.
# These credentials are for identity login only. Aida production is not hosted in Yandex Cloud.
# Redirect URIs must exactly match the callbacks configured in each provider cabinet.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=https://aidaassistent.ru/api/auth/oauth/yandex/callback
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_REDIRECT_URI=https://aidaassistent.ru/api/auth/oauth/vk/callback
OAUTH_ALLOWED_RETURN_URIS=https://aidaassistent.ru/auth
OAUTH_STATE_MINUTES=10
OAUTH_TICKET_MINUTES=5

# OAuth state + encrypted wearable cloud tokens.
# AIDA_TOKEN_ENCRYPTION_KEY must be a Fernet key generated outside the repository.
# OAUTH_STATE_SECRET should be an independent random secret of at least 32 characters.
OAUTH_STATE_SECRET=
AIDA_TOKEN_ENCRYPTION_KEY=

# Cloud wearables. Leave a provider unconfigured until official vendor credentials
# have been issued. The UI/API will report it as unavailable instead of pretending
# that the integration works.
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
OURA_REDIRECT_URI=https://aidaassistent.ru/oauth/wearables/oura/callback
OURA_SCOPES=personal daily heartrate workout spo2Daily

WITHINGS_CLIENT_ID=
WITHINGS_CLIENT_SECRET=
WITHINGS_REDIRECT_URI=https://aidaassistent.ru/oauth/wearables/withings/callback
WITHINGS_SCOPES=user.info,user.metrics,user.activity

FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
FITBIT_AUTHORIZE_URL=
FITBIT_TOKEN_URL=https://api.fitbit.com/oauth2/token
FITBIT_REDIRECT_URI=https://aidaassistent.ru/oauth/wearables/fitbit/callback
FITBIT_SCOPES=activity heartrate sleep oxygen_saturation respiratory_rate weight

# Garmin Health API access is partner-controlled. Configure endpoints only after
# Garmin approves the application and provides the correct OAuth contract.
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
GARMIN_AUTHORIZE_URL=
GARMIN_TOKEN_URL=
GARMIN_REDIRECT_URI=https://aidaassistent.ru/oauth/wearables/garmin/callback
GARMIN_SCOPES=

# Optional FatSecret Platform credentials. When absent, the nutrition diary still
# works with manual entries; FatSecret food search is shown as unavailable.
# Aida stores only FatSecret identifiers indefinitely and refreshes provider-returned
# food/nutrient snapshots before the provider's 24-hour cache limit.
FATSECRET_CLIENT_ID=
FATSECRET_CLIENT_SECRET=

# Medication references need no paid provider credentials. Aida searches free
# public references (RxNorm, PubChem and Wikidata) only on a cache miss and stores
# normalized results in the existing Google spreadsheet (medication_catalog).

# Optional test account for private QA only.
# When disabled, absolutely no demo/test medical data is created.
# When enabled, seed data is written only to this account's own profile_id.
AIDA_TEST_ACCOUNT_ENABLED=false
AIDA_TEST_ACCOUNT_EMAIL=test@aidaassistent.ru
AIDA_TEST_ACCOUNT_PASSWORD=

# Optional trusted cross-origin web clients, comma separated.
# Same-origin production can leave this empty.
AIDA_CORS_ORIGINS=

# AI/OCR provider. GEMINI_API_KEY is the preferred production variable.
# EMERGENT_LLM_KEY remains a temporary fallback for older server configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
EMERGENT_LLM_KEY=

# Compatibility placeholders used by backend/main.py only.
# backend/main.py replaces Motor with GoogleSheetsDB before server.py is imported;
# no Mongo connection is made by this production entrypoint.
MONGO_URL=google-sheets://aida
DB_NAME=aida